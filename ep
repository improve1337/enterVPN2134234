import { DatabaseSync } from "node:sqlite";
const db = new DatabaseSync("/app/data/bot.db");
db.prepare("INSERT INTO settings (key, value, updated_at) VALUES (?, ?, ?) ON CONFLICT(key) DO UPDATE SET value = excluded.value, updated_at = excluded.updated_at").run("payments_enabled", "true", new Date().toISOString());
console.log("PAYMENTS_FLAG=" + (db.prepare("SELECT value FROM settings WHERE key = ?").get("payments_enabled") || {}).value);
db.close();
