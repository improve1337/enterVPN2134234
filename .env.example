# Шаблон окружения. Скопируйте в .env и заполните.
#   Локально:  copy .env.example .env
#   На хостинге: значения вбиваются в панель окружения (файл .env туда не заливайте).

# --- Telegram (обязательно) ---
BOT_TOKEN=123456789:AA-your-token-here
BOT_USERNAME=enterservice_bot
ADMIN_IDS=123456789
# ADMIN_ID=123456789            # альтернативное имя, поддерживается тоже

# --- Бренд ---
BRAND_NAME=EnterVPN

# --- Режим работы ---
# polling — бот сам опрашивает Telegram, входящие порты не нужны. Так проще всего.
# webhook — требует PUBLIC_URL и HTTPS.
BOT_MODE=polling
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# --- Окружение ---
# ЛОКАЛЬНО:   development — логи читаемые (нужен pino-pretty из devDependencies).
# НА ХОСТИНГЕ: обязательно production. Иначе логи уходят в JSON, а если при этом
# ещё и не установлены devDependencies — раньше падало с SYNC ERROR.
NODE_ENV=development

# --- Данные ---
# ЛОКАЛЬНО:   ./data/bot.db
# В DOCKER:   /app/data/bot.db  (это persistent-том; в образе уже задано по умолчанию,
#             но если переопределить на ./data/... — база будет теряться при передеплое)
DATABASE_PATH=./data/bot.db
# Картинки экранов: приветствие, тарифы, поддержка.
BANNER_PATH=./assets/welcome.png
PLANS_IMAGE_PATH=./assets/plans.png
SUPPORT_IMAGE_PATH=./assets/support.png

# --- Прототип: без реальных платежей и без Marzban ---
# MOCK_MODE=true выдаёт фейковые ссылки-подписки и включает кнопку «Оплатить (демо)».
MOCK_MODE=true
MOCK_LANDING_URL=https://example.com

# --- Демо-оплата при боевом Marzban ---
# DEMO_PAYMENTS=true — платёж эмулируется (кнопка «Оплатить (демо)»), но подписка
# выдаётся настоящая, через Marzban. Нужен MOCK_MODE=false.
DEMO_PAYMENTS=false

# --- Ключи доступа (админка) ---
# Префикс кода ключа и размер страницы в списке ключей.
KEY_CODE_PREFIX=ENT
KEYS_PAGE_SIZE=5

# --- Реферальная программа ---
# Ссылка-приглашение: https://t.me/<BOT_USERNAME>?start=ref_<telegramId>
# REFERRAL_ENABLED=true      # включить/выключить программу
# REFERRAL_BONUS_DAYS=7      # дней пригласившему за друга, оформившего подписку
# REFERRAL_INVITEE_DAYS=3    # дополнительных дней к пробному для приглашённого

# --- Прокси для Telegram Bot API ---
# Нужен, если хостинг/провайдер блокирует api.telegram.org.
# Поддерживаются http, https, socks4, socks5. Примеры:
# TELEGRAM_PROXY=socks5://127.0.0.1:1080
# TELEGRAM_PROXY=http://user:pass@127.0.0.1:8080
# TELEGRAM_PROXY=

# --- Webhook (нужно только при BOT_MODE=webhook) ---
# PUBLIC_URL=https://bot.example.com
# WEBHOOK_PATH=/telegram/webhook
# WEBHOOK_SECRET=change-me

# --- Marzban (нужно при MOCK_MODE=false) ---
# MARZBAN_URL=http://127.0.0.1:8000
# MARZBAN_USERNAME=admin
# MARZBAN_PASSWORD=change-me

# --- Platega (нужно при MOCK_MODE=false) ---
# PLATEGA_MERCHANT_ID=...
# PLATEGA_SECRET=...

# --- Coinso (криптопроцессинг: СБП, P2P, карты, крипта) ---
# Нужно при MOCK_MODE=false. Ключи — в кабинете: проект → «Интеграция».
# Secret Key = ключ подписи вебхука (X-Signature), API Key здесь не подходит.
# COINSO_SECRET_KEY=...
# COINSO_PROJECT_ID=123
# COINSO_API_URL=https://coinso.io
# COINSO_TIMEOUT_MS=40000
# COINSO_DELIVER_TEST=false   # true — выдавать доступ и по тестовым платежам (только локально!)
# Webhook URL в кабинете: https://<ваш-домен>/webhooks/coinso
